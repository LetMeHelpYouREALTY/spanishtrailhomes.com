# Get your v0 API key here: https://v0.dev/chat/settings/keys
V0_API_KEY="your_v0_api_key"

# Optional: for rate limiting
KV_REST_API_URL=your_upstash_redis_rest_url
KV_REST_API_TOKEN=your_upstash_redis_rest_token

# Optional: for urgency banner dynamic "buyers touring" count (Calendly API)
# CALENDLY_API_KEY=your_calendly_personal_access_token
# CALENDLY_USER_URI=your_user_uri_from_calendly_api_users_me

# Cloudflare Images (hosted). Git copies live in public/images/spanish-trail (secondary).
# Public account hash from Images → Developer Resources. Safe in the browser.
# Set this AFTER `pnpm images:upload` succeeds (un-uploaded IDs 404 with err=9404).
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_HASH=byE6BTe9lNqo21V57n4aPQ
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_HASH=git
# Optional custom delivery base, e.g. https://www.spanishtrailhomes.com/cdn-cgi/imagedelivery/<hash>
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_BASE=
# Upload script (never expose the token in the browser):
# CLOUDFLARE_ACCOUNT_ID=2cc579c1ec9e426ed585e933ebf4753b
# CLOUDFLARE_API_TOKEN=
# Set to 1 to delete+reupload when a custom ID already exists:
# CLOUDFLARE_IMAGES_OVERWRITE=1
