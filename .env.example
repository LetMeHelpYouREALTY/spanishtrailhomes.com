# Get your v0 API key here: https://v0.dev/chat/settings/keys
V0_API_KEY="your_v0_api_key"

# Optional: for rate limiting
KV_REST_API_URL=your_upstash_redis_rest_url
KV_REST_API_TOKEN=your_upstash_redis_rest_token

# Optional: for urgency banner dynamic "buyers touring" count (Calendly API)
# CALENDLY_API_KEY=your_calendly_personal_access_token
# CALENDLY_USER_URI=your_user_uri_from_calendly_api_users_me

# Cloudflare Images (primary). Git copies live in public/images/spanish-trail (secondary).
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_HASH=your_images_account_hash
# Optional custom delivery base, e.g. https://www.spanishtrailhomes.com/cdn-cgi/imagedelivery/<hash>
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_BASE=
# Upload script only (never expose in the browser):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
